{
  "entry": "src/tests/sdk/main.ts",
  "target": "wasm",
  "policy": "strict",
  "out": "dist/sdk-test",
  "languageProfile": "checked-f64-utf16-v38",
  "capabilities": {
    "env": {
      "get": [
        "SDK_BASE_URL",
        "TEST_GROUP"
      ]
    },
    "net": {
      "request": {
        "urls": [
          "http://127.0.0.1:1/**"
        ],
        "methods": [
          "GET"
        ],
        "responseHeaders": [
          "content-type",
          "retry-after",
          "x-correlation-id",
          "x-request-id",
          "x-should-retry"
        ]
      }
    },
    "time": {
      "now": true,
      "timer": true
    }
  }
}
