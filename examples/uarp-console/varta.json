{
  "entry": "src/app/main.tsx",
  "target": "wasm",
  "policy": "strict",
  "out": "dist/app",
  "languageProfile": "checked-f64-utf16-v38",
  "fs": {
    "roots": {
      "data": "data"
    }
  },
  "capabilities": {
    "kv": {
      "read": [
        "/data/console.kv"
      ],
      "write": [
        "/data/console.kv"
      ]
    },
    "net": {
      "request": {
        "urls": [
          "https://api.snaga.ai/**"
        ],
        "methods": [
          "GET",
          "POST"
        ],
        "responseHeaders": [
          "retry-after",
          "x-correlation-id",
          "x-request-id",
          "x-should-retry"
        ]
      }
    },
    "time": {
      "now": true,
      "timer": true
    }
  }
}
