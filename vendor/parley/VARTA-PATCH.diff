 impl<B: Brush> LayoutContext<B> {
+    /// Bound completed glyphs, intermediate buffer slots, charged shaping
+    /// operations and retained buffer slots for each subsequent layout.
+    pub fn set_shaping_limits(
+        &mut self,
+        glyphs: usize,
+        buffer_slots: usize,
+        operations: u32,
+        cached_slots: usize,
+    ) {
+        self.scx.limits = Some((glyphs, buffer_slots, operations, cached_slots));
+    }
+
+    /// Apply an additional operation ceiling to builds until cleared. This
+    /// never raises the configured per-layout allowance.
+    pub fn set_shaping_operation_ceiling(&mut self, ceiling: Option<u32>) {
+        self.scx.operation_ceiling = ceiling;
+    }
+
+    /// Whether the last build completed without a shaping refusal.
+    pub fn shaping_succeeded(&self) -> bool {
+        !self.scx.failed
+    }
+
+    /// Charged shaping operations in the last build (not total CPU time).
+    pub fn shaping_operations(&self) -> u64 {
+        self.scx.ops_used
+    }
+
+    /// Peak glyph-info/position array slots in the last build (not total RSS).
+    pub fn shaping_peak_buffer_capacities(&self) -> (usize, usize) {
+        self.scx.peak_slots
+    }
+
+    /// Peak capacity bytes of the two shaping arrays (excluding allocator
+    /// overhead, font/analysis caches, other buffers and RSS).
+    pub fn shaping_peak_buffer_bytes(&self) -> usize {
+        self.scx
+            .peak_slots
+            .0
+            .saturating_mul(size_of::<harfrust::GlyphInfo>())
+            .saturating_add(
+                self.scx
+                    .peak_slots
+                    .1
+                    .saturating_mul(size_of::<harfrust::GlyphPosition>()),
+            )
+    }
+
+    /// Glyph-info/position array slots retained for reuse after the last build.
+    pub fn shaping_buffer_capacities(&self) -> (usize, usize) {
+        self.scx.buffer_capacities()
+    }
