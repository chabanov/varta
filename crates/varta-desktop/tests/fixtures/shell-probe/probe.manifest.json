{
  "schemaVersion": 1,
  "abiVersion": 34,
  "entry": "main.ts",
  "target": "wasm",
  "policy": "strict",
  "capabilities": [
    {
      "id": "fs.read",
      "patterns": [
        "/config/url.txt"
      ]
    },
    {
      "id": "kv.read",
      "patterns": [
        "/data/app.kv"
      ]
    },
    {
      "id": "kv.write",
      "patterns": [
        "/data/app.kv"
      ]
    },
    {
      "id": "net.request",
      "patterns": [
        "http://127.0.0.1/probe"
      ]
    }
  ],
  "fsRoots": [
    "config",
    "data"
  ]
}