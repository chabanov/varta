{
  "entry": "main.ts",
  "target": "wasm",
  "policy": "strict",
  "out": "probe",
  "languageProfile": "checked-f64-utf16-v38",
  "fs": {
    "roots": {
      "config": ".",
      "data": "."
    }
  },
  "capabilities": {
    "fs": {
      "read": ["/config/url.txt"]
    },
    "net": {
      "request": ["http://127.0.0.1/probe"]
    },
    "kv": {
      "read": ["/data/app.kv"],
      "write": ["/data/app.kv"]
    }
  }
}
